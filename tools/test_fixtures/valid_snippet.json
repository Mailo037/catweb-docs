      },
      {
        "class": "TextLabel",
        "globalid": "tx",
        "alias": "card_title",
        "text": "Component Snippet",
        "font_size": "16",
        "font_color": "#ffffff",
        "size": "{1,-20},{0,30}",
        "position": "{0,10},{0,10}",
        "align_x": "Center",
        "align_y": "Center"
      }
    ]
  }
]
